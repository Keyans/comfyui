# Pin the upstream ComfyUI release used by every node.
COMFYUI_REF=v0.31.0
CUDA_BASE_IMAGE=nvidia/cuda:12.8.1-base-ubuntu22.04

# Service settings.
COMFYUI_PORT=8288
COMFYUI_HOST=0.0.0.0
GPU_IDS=0
COMFYUI_DATABASE_PATH=/data/user/comfyui.db

# Host directories. Keep models and generated media outside Git.
COMFYUI_DATA_DIR=/srv/comfyui
COMFYUI_MODELS_DIR=/srv/comfyui/models
COMFYUI_INPUT_DIR=/srv/comfyui/input
COMFYUI_OUTPUT_DIR=/srv/comfyui/output
COMFYUI_TEMP_DIR=/srv/comfyui/temp
COMFYUI_USER_DIR=/srv/comfyui/user

# Optional: set to 1 to enable ComfyUI Manager.
ENABLE_MANAGER=1
